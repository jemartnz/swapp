# Flask
FLASK_APP=back/app
FLASK_APP_KEY=example_flask_key
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
FLASK_DEBUG=1

# JWT
JWT_SECRET_KEY=dev-jwt-secret-change-in-production

# Database
DATABASE_URL=postgresql://user:postgres@localhost:5432/example

# Google OAuth (optional for local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=

# Cloudinary (optional for local dev)
CLOUD_NAME=
API_KEY=
API_SECRET=
